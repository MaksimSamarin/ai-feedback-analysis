# Required application and database settings
# APP_SECRET encrypts saved model API keys.
# Use the PostgreSQL password in POSTGRES_PASSWORD and DATABASE_URL.
APP_SECRET=
POSTGRES_DB=review_analyzer
POSTGRES_USER=review_analyzer
POSTGRES_PASSWORD=review_analyzer
DATABASE_URL=postgresql://review_analyzer:review_analyzer@postgres:5432/review_analyzer

# Web address and sessions
# Compose serves the UI and API on the same port. CORS is relevant to a separate frontend origin.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SESSION_COOKIE_NAME=session_token
SESSION_COOKIE_SECURE=0
SESSION_USER_CACHE_TTL_SEC=15
SESSION_USER_CACHE_MAX=5000

# Model endpoints
# The model lists seed the catalog on the first start. Manage the catalog in Administration afterwards.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
OPENAI_PROVIDER_LABEL=OpenAI
OPENAI_API_KEY=
OPENAI_EXTRA_HEADERS_JSON=
OPENAI_EXTRA_BODY_JSON=
TLS_VERIFY=1
OLLAMA_BASE_URL=
OLLAMA_MODELS=
AI_PROVIDERS_CONFIG_PATH=/app/config/ai_providers.json

# Local sign-in
# Set a bootstrap login and password to create the first administrator. Registration defaults to open when SSO is off.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FORCE_PASSWORD=0
LOCAL_AUTH_ENABLED=1
LOCAL_REGISTRATION_ENABLED=

# OpenID Connect
# See docs/AUTHENTICATION.md for discovery, the callback URI, and TLS configuration.
SSO_ENABLED=0
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URL=
SSO_TOKEN_AUTH_METHOD=auto
SSO_ADMIN_SUBJECTS=
SSO_ADMIN_USERNAMES=
SSO_CA_FILE=
SSO_ALLOW_HTTP=0

# Queues and PostgreSQL connections
# Redis holds queues and leases. The response cache is stored in PostgreSQL.
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_KEY=review_analyzer:jobs
REDIS_INSPECT_QUEUE_KEY=review_analyzer:file_inspect_jobs
JOB_QUEUE_DEDUP_TTL_SEC=3600
WORKER_RUNNING_LEASE_TTL_SEC=30
WORKER_QUEUED_STALE_SEC=90
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=
HASH_PARTITIONS=100

# Analysis limits
# The upload cap applies to XLSX and CSV. Keep the Nginx request-body limit aligned.
REQUEST_TIMEOUT_SEC=180
LLM_RETRIES=2
LLM_RATE_LIMIT_RETRIES=6
LLM_RATE_LIMIT_MAX_WAIT_SEC=60
JOB_CLEANUP_DELAY_SEC=300
GROUP_MAX_ROWS=100
MAX_UPLOAD_SIZE_MB=200
GLOBAL_LLM_PARALLELISM=12

# Cache and retention
# Set the cleanup interval to 0 to disable report cleanup. A paused-report TTL of 0 disables automatic expiry.
REPORT_KEEP_LAST=20
REPORT_CLEANUP_INTERVAL_SEC=600
UPLOAD_ORPHAN_TTL_HOURS=24
PAUSED_REPORT_TTL_DAYS=0
PARTIAL_EXPORT_CACHE_ENABLED=1
PARTIAL_EXPORT_CACHE_TTL_HOURS=6
PARTIAL_EXPORT_WAIT_SEC=300
MAX_LLM_CACHE_ROWS=20000000
MAX_SEMANTIC_CACHE_ROWS=500000
CACHE_MAINTENANCE_INTERVAL_SEC=300
SEMANTIC_CACHE_ENABLED=1
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
SEMANTIC_CACHE_THRESHOLD=0.94
SEMANTIC_CACHE_CANDIDATES=200

# Logs
LOG_LEVEL=INFO
NOISY_ACCESS_LOG_SLOW_MS=250
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=10

# Optional build mirrors
# Registry prefixes end with a slash. Leave the mirror URLs empty to use the image defaults.
DOCKER_REGISTRY_PREFIX=
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=pypi.org
NPM_REGISTRY_URL=https://registry.npmjs.org/
NPM_STRICT_SSL=true
APK_REPOSITORY_MAIN_URL=
APK_REPOSITORY_COMMUNITY_URL=
APK_TLS_NO_VERIFY=false
